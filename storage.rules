rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Uploaded music files (uploader can delete their own; members read).
    match /songs/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    // Chat attachments: any signed-in member may delete so long-press delete works for everyone.
    match /chat/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
  }
}