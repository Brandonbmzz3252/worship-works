{
  "expo": {
    "name": "Worship Works",
    "slug": "worship-works",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "worshipworks",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.worshipworks.app"
    },
    "android": {
      "package": "com.worshipworks.app",
      "versionCode": 2,
      "adaptiveIcon": {
        "backgroundColor": "#12112A",
        "foregroundImage": "./assets/images/icon-foreground.png"
      },
      "permissions": [
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "WAKE_LOCK"
      ],
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#12112A",
          "image": "./assets/images/splash-branding.png",
          "imageWidth": 248
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#7E22CE",
          "defaultChannel": "default"
        }
      ],
      "expo-sharing",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "555aa2c5-5638-4915-b4b2-331497e04d98"
      }
    }
  }
}